<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.ListaSuites"
             Title="Nossas Suítes"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">
    
    <Grid RowDefinitions="Auto, *, Auto"
          Padding="15">
        
        <!-- Cabeçalho -->
        <Label Grid.Row="0" 
               Text="Nossas Acomodações"
               FontFamily="Kalam"
               FontSize="32"
               TextColor="{StaticResource Primary}"
               HorizontalOptions="Center"
               Margin="0,0,0,10"/>

        <!-- Lista de Suítes -->
        <CollectionView Grid.Row="1"
                        x:Name="coll_suites">
            
            <CollectionView.ItemTemplate>
                
                <DataTemplate>
                    
                    <Border StrokeShape="RoundRectangle 12"
                            StrokeThickness="0"
                            BackgroundColor="#1E1E1E"
                            Margin="0,0,0,15"
                            Padding="12">
                        
                        <Grid ColumnDefinitions="100, *"
                              ColumnSpacing="12">
                            <Image Grid.Column="0" 
                                   Source="{Binding Imagem}" 
                                   WidthRequest="90" 
                                   HeightRequest="90"
                                   Aspect="AspectFill"/>
                            
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="4">
                                
                                <Label Text="{Binding Descricao}" 
                                       FontSize="18" 
                                       FontAttributes="Bold" 
                                       TextColor="{StaticResource Primary}"/>

                                <Label Text="{Binding Detalhes}" 
                                       FontSize="12" 
                                       FontAttributes="Bold" 
                                       TextColor="White"/>

                                <HorizontalStackLayout Spacing="5">
                                    
                                    <Label Text="{Binding ValorDiariaAdulto, StringFormat='Adulto: R$ {0:F2}'}"
                                           FontSize="13" 
                                           TextColor="White" />
                                    
                                    <Label Text="{Binding ValorDiariaCrianca, StringFormat='Criança: R$ {0:F2}'}" 
                                           FontSize="13" 
                                           TextColor="Gray" />
                                
                                </HorizontalStackLayout>
                                
                            </VerticalStackLayout>
                            
                        </Grid>

                    </Border>
                    
                </DataTemplate>
                
            </CollectionView.ItemTemplate>
            
        </CollectionView>

        <!-- Botão Voltar -->
        <Button Grid.Row="2" 
                Text="Voltar para a Reserva" 
                BackgroundColor="{StaticResource Primary}"
                TextColor="White"
                Clicked="OnVoltarClicked"
                Margin="0,10,0,0"/>
    </Grid>
</ContentPage>