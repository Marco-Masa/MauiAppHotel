<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.PerfilHospede"
             Title="Meu Perfil"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">
    
    <ScrollView Padding="15">
        
        <VerticalStackLayout Spacing="5">
            
            <!-- Foto de Perfil -->
            <Border StrokeShape="RoundRectangle 50"
                    HeightRequest="105"
                    WidthRequest="105"
                    HorizontalOptions="Center"
                    StrokeThickness="2"
                    Stroke="{StaticResource Primary}"
                    BackgroundColor="#1E1E1E">
                
                <Image Source="hospede.png" 
                       HeightRequest="100" 
                       WidthRequest="100"
                       HorizontalOptions="Center" 
                       VerticalOptions="Center"/>
                
            </Border>

            <Label Text="Área do Hóspede" 
                   FontFamily="Kalam" 
                   FontSize="28" 
                   HorizontalOptions="Center" 
                   TextColor="{StaticResource Primary}"/>

            <!-- Dados Fictícios -->
            <Border StrokeShape="RoundRectangle 12"
                    StrokeThickness="0"
                    BackgroundColor="#1E1E1E"
                    Padding="15">
                
                <VerticalStackLayout Spacing="10">
                    
                    <Label Text="Informações de Cadastro"
                           HorizontalTextAlignment="Center"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"
                           FontSize="16"/>

                    <Label Text="Nome Completo:"
                           TextColor="Gray"
                           FontSize="12"/>
                    
                    <Entry Text="Marco Aurélio Souza Amorim"
                           IsReadOnly="True"
                           TextColor="White"
                           BackgroundColor="#2D2D2D"/>

                    <Label Text="E-mail:"
                           TextColor="Gray"
                           FontSize="12"/>
                    
                    <Entry Text="masa@uol.com.br"
                           IsReadOnly="True"
                           TextColor="White"
                           BackgroundColor="#2D2D2D"/>
                    
                </VerticalStackLayout>
                
            </Border>

            <!-- Programa de Fidelidade -->
            <Border StrokeShape="RoundRectangle 12"
                    StrokeThickness="0"
                    BackgroundColor="#1E1E1E"
                    Padding="15">
                
                <VerticalStackLayout Spacing="8">
                    
                    <Label Text="Programa de Fidelidade"
                           HorizontalTextAlignment="Center"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"
                           FontSize="16"/>
                    
                    <Grid ColumnDefinitions="*, *">
                        
                        <Label Grid.Column="0"
                               Text="Nível: Hóspede Ouro" 
                               TextColor="White" 
                               FontAttributes="Bold"
                               HorizontalOptions="Start"/>

                        <Label Grid.Column="1" 
                               Text="750 pts" 
                               TextColor="#10B981" 
                               FontAttributes="Bold"
                               HorizontalOptions="End"/>
                        
                    </Grid>
                    
                    <ProgressBar Progress="0.75"
                                 ProgressColor="{StaticResource Primary}"
                                 Margin="0,5"/>
                    
                    <Label Text="Faltam 250 pontos para você subir para a categoria Diamante!"
                           HorizontalTextAlignment="Center"
                           FontSize="12"
                           TextColor="Gray"/>
                    
                </VerticalStackLayout>
                
            </Border>

            <!-- Botões -->
            <Button Text="Salvar Alterações"
                    BackgroundColor="#10B981"
                    TextColor="White"
                    Clicked="OnSalvarClicked"/>
            
            <Button Text="Voltar"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    Clicked="OnVoltarClicked"/>
            
        </VerticalStackLayout>
        
    </ScrollView>
    
</ContentPage>
    