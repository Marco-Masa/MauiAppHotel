<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.ServicosHotel"
             Title="Serviços Disponíveis"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">

    <Grid RowDefinitions="Auto, *, Auto, Auto" Padding="15">

        <Label Grid.Row="0" 
               Text="Guia de Serviços e Lazer" 
               FontFamily="Kalam" 
               FontSize="32" 
               TextColor="{StaticResource Primary}" 
               HorizontalOptions="Center" 
               Margin="0,0,0,10"/>

        <!-- Substituído por CollectionView Horizontal com Snap (efeito de página do carrossel) -->
        <CollectionView Grid.Row="1" 
                        x:Name="col_servicos"
                        HorizontalScrollBarVisibility="Never"
                        VerticalScrollBarVisibility="Never"
                        Scrolled="OnCollectionViewScrolled">

            <!-- Configura para rolar de lado e parar exatamente no meio de cada item -->
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" 
                                   SnapPointsType="MandatorySingle" 
                                   SnapPointsAlignment="Center"/>
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <!-- Ajuste de largura explícito para o item ocupar quase toda a tela lateralmente -->
                    <Border StrokeShape="RoundRectangle 16" 
                            StrokeThickness="0" 
                            BackgroundColor="#1E1E1E" 
                            Margin="10,0" 
                            Padding="20" 
                            WidthRequest="320"
                            VerticalOptions="CenterAndExpand">
                        <VerticalStackLayout Spacing="15" HorizontalOptions="Center">

                            <Image Source="{Binding Foto}" 
                                   WidthRequest="100" 
                                   HeightRequest="100" 
                                   HorizontalOptions="Center"/>

                            <Label Text="{Binding Titulo}" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource Primary}" HorizontalOptions="Center"/>
                            <Label Text="{Binding Horario}" FontSize="14" TextColor="#10B981" HorizontalOptions="Center" FontAttributes="Bold"/>
                            <Label Text="{Binding Descricao}" FontSize="15" TextColor="White" HorizontalTextAlignment="Center" LineBreakMode="WordWrap"/>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Mantemos o IndicatorView, mas ele será puramente visual -->
        <IndicatorView Grid.Row="2" 
                       x:Name="indicatorView" 
                       IndicatorColor="Gray" 
                       SelectedIndicatorColor="{StaticResource Primary}" 
                       HorizontalOptions="Center" 
                       Margin="0,10"
                       InputTransparent="True"/>
        <!-- Evita que cliques errados disparem o bug -->

        <Button Grid.Row="3" 
                Text="Voltar para a Reserva" 
                BackgroundColor="{StaticResource Primary}" 
                TextColor="White" 
                Clicked="OnVoltarClicked" 
                Margin="0,10,0,0"/>
    </Grid>
</ContentPage>